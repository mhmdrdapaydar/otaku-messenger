# ── ربات تلگرام ─────────────────────────────────────────────────
# توکن را از BotFather بگیرید (دستور /newbot). هرگز آن را کامیت نکنید.
BOT_TOKEN=YOUR_BOT_TOKEN_FROM_BOTFATHER

# آیدی عددی ادمین (پیش‌فرض داخل config.py: 5222486166)
ADMIN_ID=5222486166

# ── کیف پول هات ─────────────────────────────────────────────────
# عبارت بازیابی ۱۲ کلمه‌ای و کلید خصوصی — فقط اینجا، هرگز در کد/گیت
WALLET_MNEMONIC=your twelve word recovery phrase goes here
WALLET_PRIVATE_KEY=0xyourprivatekeyhex

# اختیاری: endpoint اختصاصی RPC برای BNB Smart Chain (با کاما چندتایی کنید)
# BSC_RPC_URL=https://bsc-dataseed.binance.org
